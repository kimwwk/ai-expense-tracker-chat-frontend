# ---------------------------------------------------------------------------
# AI Expense Tracker — chat frontend
# Copy to `.env.local` for local dev. On Vercel, set these as Project env vars.
# ---------------------------------------------------------------------------

# OpenAI access for the AI chat route (app/api/chat/route.ts). Server-side only;
# never shipped to the browser. (On Vercel this can also be served via the
# AI Gateway instead of a raw key.)
OPENAI_API_KEY=

# --- Backend mode ----------------------------------------------------------
# The app ships with a built-in, in-memory mock backend (lib/api/mock), so it
# runs fully without any external service — ideal for the public demo.
#
#   unset / "true"  -> mock ON  (default; demo works with zero infra)
#   "false"         -> mock OFF (calls the real NEXT_PUBLIC_API_BASE_URL)
#
# NOTE: NEXT_PUBLIC_* values are baked in at build time — change this in Vercel
# and trigger a redeploy for it to take effect.
NEXT_PUBLIC_USE_MOCK_API=true

# Base URL of a real ai-expense-tracker-service deployment.
# Only used when NEXT_PUBLIC_USE_MOCK_API="false". No trailing slash.
# e.g. https://your-service.up.railway.app
NEXT_PUBLIC_API_BASE_URL=
